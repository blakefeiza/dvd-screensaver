<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.blakefeiza.dvd-screensaver" extension-version="1.1.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Bouncing DVD logo. Drag measures onto the Marks card and they appear on every corner hit.</description>
    <author name="Blake Feiza" email="" organization="" website="https://github.com/blakefeiza/dvd-screensaver"/>
    <min-api-version>1.1</min-api-version>
    <source-location>
      <url>https://blakefeiza.github.io/dvd-screensaver/index.html</url>
    </source-location>
    <icon></icon>
  </worksheet-extension>
  <resources>
    <resource id="name"><text locale="en_US">DVD Screensaver</text></resource>
  </resources>
</manifest>
